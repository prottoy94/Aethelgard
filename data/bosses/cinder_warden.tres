; Cinder Warden (GAME_DESIGN.md §7.2, boss 1): an Emberbound captain in the scorched clearing north of Elderroot
; Meadow (owner decision 2026-11-04). Tests dodging telegraphs and stamina: slow, long warnings, few attacks.
; Phase 2 (60%) adds the Cinder Ring and calls two Ember Wisps; phase 3 (30%) charges twice and throws embers.
; Ember element: weak to Light and Frost. Rewards: Ember Core #1 (approved 2026-11-04), the Ember-Ward Ring and its recipe.
[resource]
script = ExtResource("1")
id = &"cinder_warden"
display_name = "Cinder Warden"
element = 6
rank = "D"
max_health = 240.0
defense = 1.0
move_speed = 3.0
wander_speed = 0.0
knockback_resistance = 0.85
aggro_range = 0.0
leash_range = 60.0
attack_range = 2.8
telegraph_time = 1.0
attack_damage = 14.0
attack_radius = 3.0
recover_time = 1.2
stagger_time = 0.4
stagger_resistant = true
title = "Emberbound Captain"
phases = Array[ExtResource("3")]([SubResource("phase_1"), SubResource("phase_2"), SubResource("phase_3")])
music = &"mus_boss_ascent"
defeat_flag = &"warden_defeated"
reward_items = Array[ExtResource("4")]([ExtResource("core"), ExtResource("ring_item"), ExtResource("potion"), ExtResource("potion")])
reward_recipes = Array[ExtResource("5")]([ExtResource("ring_recipe")])
