[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://src/quests/quest_data.gd" id="1"]
[ext_resource type="Script" path="res://src/quests/quest_step.gd" id="2"]
[ext_resource type="Script" path="res://src/items/item_data.gd" id="3"]
[ext_resource type="Script" path="res://src/items/recipe_data.gd" id="4"]
